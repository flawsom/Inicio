# Copy this file to `.env` and replace every value before starting the stack.
# `.env` is gitignored; this example is not.
#
#   cd docker/superset
#   cp env.example .env
#   openssl rand -hex 32   # paste the result into SUPERSET_SECRET_KEY
#   docker compose up -d
#
# Superset itself is Apache-2.0 and has no seat or report licence. The only
# recurring cost is the host it runs on; see docs/FREE-BI.md.

SUPERSET_SECRET_KEY=replace-with-openssl-rand-hex-32
SUPERSET_DB_PASSWORD=replace-with-a-long-password
SUPERSET_ADMIN_USER=admin
SUPERSET_ADMIN_PASSWORD=replace-with-a-long-password
SUPERSET_ADMIN_EMAIL=admin@example.com
SUPERSET_BI_DATABASE_NAME=Inicio BI
SUPERSET_PORT=8088
# Loopback keeps the HTTP admin login off a cloud VM's public interface.
SUPERSET_BIND_ADDRESS=127.0.0.1
