{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm --filter @inicio/engine build && pnpm --filter @inicio/web build",
  "outputDirectory": "apps/web/dist",
  "functions": {
    "api/ingest.ts": {
      "memory": 1024,
      "maxDuration": 60
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/ingest?inicio_route=api" },
    { "source": "/api", "destination": "/api/ingest?inicio_route=api" },
    { "source": "/auth/:path*", "destination": "/api/ingest?inicio_route=auth" },
    { "source": "/health", "destination": "/api/ingest?inicio_route=health" },
    { "source": "/((?!api/|assets/).*)", "destination": "/index.html" }
  ]
}
