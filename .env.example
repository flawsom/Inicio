# ---------------------------------------------------------------------------
# Inicio platform — environment template
# Copy to .env and fill in. NEVER commit a real .env (see .gitignore).
# ---------------------------------------------------------------------------

# --- runtime ---
NODE_ENV=development
PORT=3001
APP_ORIGIN=http://localhost:3000   # Vite dev server (preview port)

# --- database ---
# DATABASE_URL       = least-privilege app role (RLS is only enforced for
#                      non-superuser, non-BYPASSRLS roles).
# MIGRATION_DATABASE_URL = owner/superuser used only for DDL by `pnpm db:migrate`.
DATABASE_URL=postgres://app_role:app_dev_password@localhost:5432/inicio
MIGRATION_DATABASE_URL=postgres://postgres:postgres@localhost:5432/inicio
DATABASE_SSL=false   # true for Neon / Tiger Cloud and most managed Postgres
APP_DB_PASSWORD=app_dev_password

# --- auth / OTP ---
# 32+ bytes of random data. Generate: openssl rand -hex 32
OTP_PEPPER=dev-only-pepper-change-me-0000000000000000
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=3
OTP_RESEND_COOLDOWN_SECONDS=60
SESSION_COOKIE_NAME=sid
SESSION_IDLE_MINUTES=480
SESSION_ABSOLUTE_DAYS=30
COOKIE_SECURE=false                 # true behind HTTPS in production

# --- email (nodemailer over SMTP — provider agnostic) ---
# dev  : Mailpit (docker compose) — nothing leaves the machine
# prod : your relay. Resend: smtp.resend.com:465 user "resend", pass = API key.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Inicio Survey <no-reply@inicio.example>"

# --- mail transport selection ---
# smtp   : nodemailer over SMTP (default — Mailpit locally, any relay in prod)
# resend : the provider's HTTPS API on port 443. Choose this when the network
#          refuses SMTP ports (25/465/587), which is common on PaaS and on
#          locked-down egress. Note that with a sending-only key and no verified
#          domain, a relay will only deliver to its own account address.
# Leave unset to infer: a RESEND_API_KEY means `resend`, otherwise `smtp`.
# MAIL_TRANSPORT=resend
# RESEND_API_KEY=
# RESEND_API_URL=https://api.resend.com/emails

# --- cache / queue (Valkey; optional in Phase 1) ---
REDIS_URL=redis://localhost:6379

# --- admin bootstrap (used once by `pnpm admin:create`; never a default) ---
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- access control ---
# Accounts are invitation only: an unknown address cannot create an account, it
# must be invited by an owner or admin of an organisation. Set to false only for a
# deliberate open-signup deployment; the default is the safe one.
INVITE_ONLY=true
