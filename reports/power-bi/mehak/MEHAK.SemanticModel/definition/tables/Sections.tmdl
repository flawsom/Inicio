table Sections
	measure 'Plotted section questions' = SUM('Sections'[Questions])
		formatString: #,##0
	measure 'Plotted section minutes' = SUM('Sections'[Est. minutes])
		formatString: 0.0
	column SectionKey
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: SectionKey
	column Section
		dataType: string
		summarizeBy: none
		sortByColumn: SectionOrder
		sourceColumn: SectionText
	column SectionOrder
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: SectionOrder
	column Questions
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: QuestionCount
	column Answerable
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: AnswerableCount
	column Required
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: RequiredCount
	column Conditional
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: ConditionalCount
	column Routed
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: RoutedCount
	column Constraints
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: ConstraintCount
	column Choices
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: ChoiceCount
	column 'Est. minutes'
		dataType: double
		formatString: 0.0
		summarizeBy: none
		sourceColumn: EstimatedMinutes
	column '% burden'
		dataType: double
		formatString: 0.0%
		summarizeBy: none
		sourceColumn: BurdenShare
	column SectionFull
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: SectionFull
	partition Sections = m
		mode: import
		source =
				let
				    Source = #table(
				        type table [SectionKey = text, SectionText = text, SectionOrder = Int64.Type, QuestionCount = Int64.Type, AnswerableCount = Int64.Type, RequiredCount = Int64.Type, ConditionalCount = Int64.Type, RoutedCount = Int64.Type, ConstraintCount = Int64.Type, ChoiceCount = Int64.Type, EstimatedMinutes = number, BurdenShare = number, SectionFull = text],
				        {
				            {"g_bg_101", "Interviewer & Respondent Info", 1, 5, 5, 5, 0, 0, 4, 0, 3.1333333333333333, 0.15986394557823128, "Interviewer & Respondent Info"},
				            {"g_screener", "Screener", 2, 18, 15, 15, 0, 15, 0, 61, 7.633333333333334, 0.38945578231292516, "Screener"},
				            {"g_bg_term", "Main Questionnaire", 3, 24, 19, 19, 0, 24, 0, 90, 7.683333333333334, 0.3920068027210884, "Main Questionnaire"},
				            {"g_bg_interviewer_instruction_show_scr", "INTERVIEWER INSTRUCTION: SHOW SCREEN FQ17. Plea…", 4, 3, 3, 3, 0, 3, 0, 27, 1.1, 0.05612244897959184, "INTERVIEWER INSTRUCTION: SHOW SCREEN FQ17. Please rank the top 3 fragrances based on how well suited they are to the Mangaldeep brand, where rank 1 is the fragrance best suited to Mangaldeep, rank 2 is the next best suited, and rank 3 is the third best suited."},
				            {"unassigned", "Unassigned section", 5, 10, 0, 0, 0, 1, 0, 0, 0.05, 0.002551020408163265, "Unassigned section"}
				        }
				    )
				in
				    Source
