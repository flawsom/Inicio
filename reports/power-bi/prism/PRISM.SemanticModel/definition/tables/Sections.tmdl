table Sections
	measure 'Plotted section questions' = SUM('Sections'[Questions])
		formatString: #,##0
	measure 'Plotted section minutes' = SUM('Sections'[Est. minutes])
		formatString: 0.0
	column SectionKey
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: SectionKey
	column Section
		dataType: string
		summarizeBy: none
		sortByColumn: SectionOrder
		sourceColumn: SectionText
	column SectionOrder
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: SectionOrder
	column Questions
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: QuestionCount
	column Answerable
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: AnswerableCount
	column Required
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: RequiredCount
	column Conditional
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: ConditionalCount
	column Routed
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: RoutedCount
	column Constraints
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: ConstraintCount
	column Choices
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: ChoiceCount
	column 'Est. minutes'
		dataType: double
		formatString: 0.0
		summarizeBy: none
		sourceColumn: EstimatedMinutes
	column '% burden'
		dataType: double
		formatString: 0.0%
		summarizeBy: none
		sourceColumn: BurdenShare
	column SectionFull
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: SectionFull
	partition Sections = m
		mode: import
		source =
				let
				    Source = #table(
				        type table [SectionKey = text, SectionText = text, SectionOrder = Int64.Type, QuestionCount = Int64.Type, AnswerableCount = Int64.Type, RequiredCount = Int64.Type, ConditionalCount = Int64.Type, RoutedCount = Int64.Type, ConstraintCount = Int64.Type, ChoiceCount = Int64.Type, EstimatedMinutes = number, BurdenShare = number, SectionFull = text],
				        {
				            {"g_bg_101", "Interviewer & Respondent Info", 1, 2, 2, 2, 0, 0, 2, 0, 1.0166666666666666, 0.10445205479452055, "Interviewer & Respondent Info"},
				            {"g_screener", "Screener", 2, 20, 13, 13, 0, 18, 0, 44, 5.133333333333334, 0.5273972602739727, "Screener"},
				            {"g_bg_term", "Main Questionnaire", 3, 12, 9, 9, 0, 8, 1, 39, 2.8666666666666667, 0.2945205479452055, "Main Questionnaire"},
				            {"g_bg_dq1", "Please select the salt promo that you are most…", 4, 2, 2, 2, 0, 2, 1, 8, 0.6666666666666666, 0.0684931506849315, "Please select the salt promo that you are most likely to buy and the promo that you are least likely to buy. MAXDIFF OPTIONS TO BE SHOWN HERE"},
				            {"unassigned", "Unassigned section", 5, 11, 0, 0, 0, 1, 0, 0, 0.05, 0.005136986301369864, "Unassigned section"}
				        }
				    )
				in
				    Source
