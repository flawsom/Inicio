    "objects": {
      "general": [
        {
          "properties": {
            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "6 analysis families are represented. 21 questions call for a categorical distribution, 3 for verbatim coding and 2 for a numeric distribution; these are different analytical contracts and should not be collapsed into one “percentage” column.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "8.8pt",
                      "color": "#1C1917",
                      "fontWeight": "normal"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "No inferential test is pre-committed here. Significance, subgroup comparisons and driver analysis depend on the sampling design, achieved base and the response data — none of which are fabricated in this build.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "8.8pt",
                      "color": "#1C1917",
                      "fontWeight": "normal"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Conditional questions must be analysed on their eligible base. A percentage with the total sample as its denominator is a design error, not a finding.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "8.8pt",
                      "color": "#1C1917",
                      "fontWeight": "normal"
                    }
                  }
                ]
              }
            ]
          }
        }
      ]
    },
