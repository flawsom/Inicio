                      "fontFamily": "Segoe UI",
                      "fontSize": "8.8pt",
                      "color": "#1C1917",
                      "fontWeight": "normal"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Estimated respondent time is highest in “Screener” at 5.1 minutes (53% of the design burden). This is where field length and fatigue deserve a deliberate review.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "8.8pt",
                      "color": "#1C1917",
                      "fontWeight": "normal"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "26 questions require an answer in at least one path. Conditional requirements are not the same as optional questions: check the route before treating a blank as missing data.",
