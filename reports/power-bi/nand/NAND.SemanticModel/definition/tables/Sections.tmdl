table Sections
	measure 'Plotted section questions' = SUM('Sections'[Questions])
		formatString: #,##0
	measure 'Plotted section minutes' = SUM('Sections'[Est. minutes])
		formatString: 0.0
	column SectionKey
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: SectionKey
	column Section
		dataType: string
		summarizeBy: none
		sortByColumn: SectionOrder
		sourceColumn: SectionText
	column SectionOrder
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: SectionOrder
	column Questions
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: QuestionCount
	column Answerable
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: AnswerableCount
	column Required
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: RequiredCount
	column Conditional
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: ConditionalCount
	column Routed
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: RoutedCount
	column Constraints
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: ConstraintCount
	column Choices
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: ChoiceCount
	column 'Est. minutes'
		dataType: double
		formatString: 0.0
		summarizeBy: none
		sourceColumn: EstimatedMinutes
	column '% burden'
		dataType: double
		formatString: 0.0%
		summarizeBy: none
		sourceColumn: BurdenShare
	column SectionFull
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: SectionFull
	partition Sections = m
		mode: import
		source =
				let
				    Source = #table(
				        type table [SectionKey = text, SectionText = text, SectionOrder = Int64.Type, QuestionCount = Int64.Type, AnswerableCount = Int64.Type, RequiredCount = Int64.Type, ConditionalCount = Int64.Type, RoutedCount = Int64.Type, ConstraintCount = Int64.Type, ChoiceCount = Int64.Type, EstimatedMinutes = number, BurdenShare = number, SectionFull = text],
				        {
				            {"g_screener", "Screener", 1, 219, 186, 186, 0, 213, 1, 627, 84.21666666666667, 0.9584597875569045, "Screener"},
				            {"g_matrix_184", "Statements", 2, 12, 12, 12, 0, 12, 0, 36, 3.6, 0.0409711684370258, "Statements"},
				            {"unassigned", "Unassigned section", 3, 11, 0, 0, 0, 1, 0, 0, 0.05, 0.0005690440060698029, "Unassigned section"}
				        }
				    )
				in
				    Source
