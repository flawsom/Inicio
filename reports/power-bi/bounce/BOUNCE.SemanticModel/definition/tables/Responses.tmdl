	partition Responses = m
		mode: import
		source =
				let
				    Source = #table(
				        type table [ResponseId = text, Status = text, StartedAt = datetime, SubmittedAt = datetime, DurationMinutes = number, DeviceId = text, Interviewer = text, SectionReached = text, CompletionPct = number, ConflictCount = Int64.Type, FlagCount = Int64.Type],
