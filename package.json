{
  "name": "inicio-survey-portal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Inicio \u2014 multi-tenant survey and data-collection platform (schema, RLS, authoring studio, offline collection, exports)",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "build:engine": "pnpm --filter @inicio/engine build",
    "test": "pnpm run build:engine && pnpm -r --if-present test",
    "coverage": "pnpm run build:engine && pnpm -r --if-present coverage",
    "e2e:consumer": "node scripts/e2e-consumer.mjs",
    "e2e:offline": "node scripts/e2e-offline.mjs",
    "lint": "eslint .",
    "typecheck": "pnpm run build:engine && pnpm -r --if-present typecheck && tsc -p api/tsconfig.json",
    "dev:api": "pnpm --filter @inicio/api dev",
    "dev:web": "pnpm --filter @inicio/web dev",
    "dev:preview": "pnpm --parallel --filter @inicio/api --filter @inicio/web run dev:preview",
    "budgets": "node scripts/check-budgets.mjs",
    "fabric:deploy": "node scripts/fabric-deploy.mjs",
    "fabric:test": "node --test scripts/fabric-deploy.test.mjs",
    "powerbi:report": "node scripts/build-powerbi-report.mjs",
    "powerbi:test": "node --test scripts/build-powerbi-report.test.mjs",
    "superset:provision": "node scripts/superset-provision.mjs",
    "superset:test": "node --test scripts/superset-provision.test.mjs",
    "icons": "node scripts/make-icons.mjs",
    "drift": "node scripts/check-drift.mjs",
    "db:migrate": "pnpm --filter @inicio/api db:migrate",
    "admin:create": "pnpm --filter @inicio/api admin:create"
  },
  "devDependencies": {
    "@neon/config": "^1.9.1",
    "@neon/env": "^1.6.1",
    "eslint": "^9.15.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.16.0"
  }
}
